{
  "name": "receipts",
  "version": "0.1.0",
  "private": true,
  "description": "Receipts — consumer front door for promise-to-action accountability lookups",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "API_PORT=${API_PORT:-8787} npm run dev --workspace @receipts/server",
    "dev:web": "npm run dev --workspace @receipts/web",
    "build": "npm run build --workspace @receipts/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/shared packages/server packages/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
